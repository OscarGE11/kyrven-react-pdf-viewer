---
import { Copy, Terminal } from 'lucide-react';
---
<div class="install-command" id="install"><Terminal size={19} aria-hidden="true" /><code>npm i @kyrven/react-pdf-viewer</code><button aria-label="Copy installation command" data-copy="npm i @kyrven/react-pdf-viewer"><Copy size={18} /></button></div>
<p class="copy-feedback" aria-live="polite" data-copy-feedback></p>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      const feedback = document.querySelector('[data-copy-feedback]');
      try { await navigator.clipboard.writeText(button.dataset.copy!); if (feedback) feedback.textContent = 'Copied to clipboard'; }
      catch { if (feedback) feedback.textContent = 'Select the command and copy it manually.'; }
    });
  });
</script>
